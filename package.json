{
  "name": "wodge",
  "description": "A collaborative workspace.",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev dev:api",
    "studio": "turbo db:studio",
    "generate": "turbo db:generate",
    "migrate": "pnpm --filter backend db:migration:cloud",
    "migrate:local": "turbo db:migration:local",
    "drop": "turbo db:drop",
    "lint": "oxlint --deny-warnings .",
    "add:comp": "turbo add:comp",
    "reset:app": "rm -rf ./apps/web/.wrangler ./apps/backend/.wrangler",
    "init:app": "pnpm --filter backend db:migration:local",
    "livekit": "livekit-server --dev --bind 0.0.0.0",
    "deploy:app": "turbo deploy:app",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:feature-flags": "vitest run --workspace vitest.feature-flags.workspace.ts --no-cache --maxWorkers=2 --minWorkers=1",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@wodge/ts": "workspace:*",
    "tsx": "^4.7.1",
    "turbo": "^2.0.6",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "wrangler": "^3.28.3",
    "oxlint": "1.89.0",
    "oxfmt": "0.74.0"
  },
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@9.4.0"
}
