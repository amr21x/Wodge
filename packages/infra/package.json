{
  "name": "@wodge/infra",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --incremental false --pretty false",
    "db:generate": "drizzle-kit generate --config database/drizzle.config.ts",
    "db:drop": "drizzle-kit drop --config database/drizzle.config.ts",
    "db:generate:objects": "node database/generate-object-migrations.mjs",
    "db:check:objects": "node database/bundle-object-migrations.mjs --check"
  },
  "dependencies": {
    "@wodge/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "jose": "^5.4.1",
    "@aws-sdk/client-s3": "^3.554.0",
    "@aws-sdk/s3-request-presigner": "^3.554.0",
    "stripe": "^16.1.0",
    "nanoid": "^5.0.6",
    "@smithy/fetch-http-handler": "2.5.0",
    "livekit-server-sdk": "^2.1.2",
    "@wodge/env": "workspace:*",
    "tsyringe": "4.10.0"
  },
  "devDependencies": {
    "@wodge/ts": "workspace:*",
    "typescript": "^5.3.3",
    "drizzle-kit": "0.31.4",
    "@cloudflare/workers-types": "4.20260424.1"
  }
}
