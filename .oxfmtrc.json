{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.wrangler/**",
    "**/.vercel/**",
    "**/dist/**",
    "**/coverage/**",
    "pnpm-lock.yaml"
  ],
  "overrides": [
    {
      "files": ["apps/web/**/*.{js,cjs,mjs,jsx,ts,tsx,css}"],
      "options": {
        "sortTailwindcss": {
          "config": "./apps/web/tailwind.config.ts",
          "functions": ["clsx", "cn"]
        }
      }
    }
  ]
}
