{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wodge-backend",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Production shares the web origin: these paths go to the Worker and Pages serves
  // everything else. `wrangler dev` ignores routes; deploys override the local vars.
  "workers_dev": false,
  "routes": [
    { "pattern": "wodge.amr21.dev/api/*", "zone_name": "amr21.dev" },
    { "pattern": "wodge.amr21.dev/parties/*", "zone_name": "amr21.dev" },
    { "pattern": "wodge.amr21.dev/health", "zone_name": "amr21.dev" },
  ],
  "vars": {
    "INTEGRATION_MODE": "partial",
    "APP_DOMAIN": "http://localhost:3000",
    "BACKEND_DOMAIN": "http://localhost:8787",
    "AVATARS_URL": "https://avatars.wodge.xyz",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wodge",
      "database_id": "f17da2ae-c255-422f-99ad-b8b93733b758",
      "migrations_dir": "../../packages/domain/migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "User",
        "class_name": "UserServer",
      },
      {
        "name": "Workspace",
        "class_name": "WorkspaceServer",
      },
      {
        "name": "Room",
        "class_name": "RoomServer",
      },
      {
        "name": "Thread",
        "class_name": "ThreadServer",
      },
      {
        "name": "Page",
        "class_name": "PageServer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "UserServer",
        "WorkspaceServer",
        "RoomServer",
        "ThreadServer",
        "PageServer",
      ],
    },
  ],
}
