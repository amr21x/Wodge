{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy:app": "wrangler deploy",
    "test:foundation": "node tests/foundation/verify.mjs",
    "test:pages": "vitest run tests/integration/pages.test.ts --maxWorkers=2 --minWorkers=1",
    "test": "vitest run tests --maxWorkers=2 --minWorkers=1",
    "db:migration:local": "wrangler d1 migrations apply wodge --local",
    "db:migration:cloud": "wrangler d1 migrations apply wodge --remote",
    "db:studio": "pnpm --filter @wodge/infra exec drizzle-kit studio --config database/drizzle.local.config.ts",
    "test:runtime": "node tests/runtime/verify.mjs",
    "build": "wrangler deploy --dry-run",
    "test:api": "tsc -p tests/types/client/tsconfig.json --pretty false"
  },
  "dependencies": {
    "cookie-parse": "^0.4.0",
    "hono": "4.13.13",
    "immer": "^10.0.3",
    "nanoid": "^5.0.5",
    "object-sizeof": "^2.6.4",
    "partysocket": "^0.0.25",
    "query-string": "^9.0.0",
    "replicache": "^15.3.0",
    "zod": "^3.22.4",
    "partyserver": "0.5.10",
    "y-partyserver": "2.2.0",
    "yjs": "13.6.14",
    "@wodge/domain": "workspace:*",
    "@wodge/core": "workspace:*",
    "@wodge/infra": "workspace:*",
    "@wodge/auth": "workspace:*",
    "hono-party": "2.1.0",
    "tsyringe": "4.10.0",
    "reflect-metadata": "0.2.2",
    "@wodge/env": "workspace:*"
  },
  "devDependencies": {
    "@wodge/ts": "workspace:*",
    "@types/lodash": "^4.14.202",
    "lodash": "^4.17.21",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "vitest-environment-miniflare": "^2.14.2",
    "@cloudflare/workers-types": "4.20260424.1",
    "wrangler": "4.152.0",
    "fake-indexeddb": "^5.0.2",
    "jsdom": "^24.0.0"
  },
  "exports": {
    "./api": {
      "types": "./src/types/api-types.ts"
    }
  }
}
