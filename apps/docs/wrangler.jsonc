{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wodge-docs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "wodge.amr21.dev/docs*",
      "zone_name": "amr21.dev",
    },
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
  },
  "main": "src/worker.ts",
  "services": [
    {
      "binding": "WEB",
      "service": "wodge-web",
    },
  ],
}
