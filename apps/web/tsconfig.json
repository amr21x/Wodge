{
  "extends": "@wodge/ts/tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "@cloudflare/workers-types/2023-07-01"
    ],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/ui/components/data-table/settings-data-table.tsx",
    "src/components/workspace/sidebar/add-to-team.tsx",
    "src/components/resources/advanced-uploadtsx",
    "src/lib/utils/is-custom-node-selected.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
