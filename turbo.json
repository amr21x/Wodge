{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:drop": {
      "cache": false
    },
    "db:migration:local": {
      "cache": false
    },
    "db:migration:cloud": {
      "cache": false
    },
    "db:studio": {
      "cache": false
    },
    "add:comp": {
      "cache": false
    },
    "deploy:app": {
      "cache": false
    },
    "backend#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "workers:build": {
      "dependsOn": ["^build"],
      "outputs": [".open-next/**", ".next/**", "!.next/cache/**"]
    },
    "docs#build": {
      "outputs": ["dist/**"]
    }
  }
}
